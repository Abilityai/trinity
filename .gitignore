# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
# No trailing slash: the slash forms match DIRECTORIES only, so a *symlink*
# named .venv slipped past them and was committed (#2082 shipped one pointing
# at a developer's home directory). These also match a symlink or a file.
.venv
.venv/
.venv*
.venv*/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# The setuptools block above ends with a BARE `parts/`, which git applies at
# every depth — so it also swallows `src/frontend/src/components/tiles/parts/`,
# where the grid's presentational tile sub-components live (ent#100). The
# directory is re-included first: git cannot re-include a file whose PARENT
# directory is excluded, so `!.../parts/*.vue` alone would silently do nothing.
# Symptom if this is ever removed: a component that builds locally, is missing
# from the commit, and fails the frontend build in CI.
!src/frontend/src/components/tiles/parts/
!src/frontend/src/components/tiles/parts/**

# uv lockfile (repo uses pyproject.toml for pytest only; empty lockfile is noise)
uv.lock

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

