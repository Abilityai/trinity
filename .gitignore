.env
.env.local
.env.*.local
.env.prod

# MCP configuration with credentials
.mcp.json

# Docker
*.pid

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Claude Code local settings (not the .claude folder itself)
.claude/settings.local.json

