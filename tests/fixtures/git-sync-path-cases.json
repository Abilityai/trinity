  {"path": "-f", "accept": false, "note": "short option: force-stages an ignored file"},
  {"path": "--force", "accept": false, "note": "long option"},
  {"path": "-", "accept": false, "note": "a lone dash"},
  {"path": "--", "accept": false, "note": "end-of-options marker"},
