{
  "name": "trinity-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for orchestrating Trinity agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector http://localhost:8080/mcp",
    "test": "node --import tsx --test src/*.test.ts src/tools/*.test.ts"
  },
  "keywords": [
    "mcp",
    "trinity",
    "agent",
    "orchestration"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "fastmcp": "^4.22.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "hono": ">=4.13.0",
    "axios": ">=1.15.2",
    "fast-uri": "^3.1.9",
    "@hono/node-server": ">=1.19.13",
    "ip-address": ">=10.7.2",
    "qs": ">=6.15.2",
    "esbuild": ">=0.28.1"
  }
}
