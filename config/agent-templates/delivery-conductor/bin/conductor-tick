#!/usr/bin/env bash
set -euo pipefail

WORKSPACE_ROOT=/home/developer
CURRENT_DIRECTORY="$(pwd -P)"

if [ "$CURRENT_DIRECTORY" != "$WORKSPACE_ROOT" ]; then
  printf '%s\n' "conductor-tick must run from the agent workspace root" >&2
  exit 64
fi

cd -- "$WORKSPACE_ROOT"
TEMPLATE_LIBRARY="$WORKSPACE_ROOT/lib"

if [ ! -d "$TEMPLATE_LIBRARY" ] || [ -L "$TEMPLATE_LIBRARY" ]; then
  printf '%s\n' "conductor-tick could not find its template library" >&2
  exit 65
fi

export PYTHONPATH="$WORKSPACE_ROOT/lib"
export PATH="/usr/local/bin:/usr/bin:/bin"
exec python -P -m delivery_conductor.cli "$@"
