{
  "bash_deny": [
    {
      "pattern": "\\brm\\s+(-[a-zA-Z]*[rRfF][a-zA-Z]*\\s+)+(/|~|\\$HOME)(\\s|$)",
      "reason": "recursive deletion of root or home directory"
    },
    {
      "pattern": "\\bchmod\\s+-?R?\\s*777\\b",
      "reason": "world-writable permissions blowout"
    },
    {
      "pattern": "(curl|wget)\\s+[^|;&]*\\|\\s*(sh|bash|zsh|ksh)\\b",
      "reason": "piping remote content into a shell"
    },
    {
      "pattern": "\\bgit\\s+push\\b.*?(--force\\b|--force-with-lease\\b|(?<=\\s)-f\\b)",
      "reason": "git force push"
    },
    {
      "pattern": "\\bkill\\s+-9\\s+1\\b",
      "reason": "killing the init process"
    },
    {
      "pattern": "\\bdd\\s+[^;|]*\\bof=/dev/[sh]d",
      "reason": "writing directly to a raw block device"
    },
    {
      "pattern": "\\bmkfs\\.[a-z0-9]+\\b",
      "reason": "formatting a filesystem"
    },
    {
      "pattern": ":\\s*\\(\\s*\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:",
      "reason": "fork bomb"
    },
    {
      "pattern": "(\\.trinity/read-only-config\\.json).*[>|]|[>|].*(\\.trinity/read-only-config\\.json)",
      "reason": "modifying read-only mode configuration"
    },
    {
      "pattern": "\\bshutdown\\s+-[hr]\\b|\\breboot\\s+-f\\b|\\bpoweroff\\b",
      "reason": "host shutdown"
    },
    {
      "pattern": "(?s)\\A(?=.*\\bsudo\\b).*(?:/etc/claude-code|/opt/trinity|/etc/sudoers)|\\bvisudo\\b",
      "reason": "sudo touching the guardrail registration, hooks or sudoers"
    },
    {
      "pattern": "\\bsudo(?:\\s+(?:-[ugCDhprtUT](?:\\S+|\\s+\\S+)|--[a-z][\\w-]*(?:=\\S+)?|-(?![ugCDhprtUT])[a-zA-Z]+))*?\\s+(?:-[a-zA-Z]*[is][a-zA-Z]*|--login|--shell)(?=\\s|$)|\\bsudo(?:\\s+(?:-[ugCDhprtUT](?:\\S+|\\s+\\S+)|--[a-z][\\w-]*(?:=\\S+)?|-(?![ugCDhprtUT])[a-zA-Z]+))*?\\s+(?:/\\S*/)?su(?=\\s|$|[;&|)])|\\bsudo(?:\\s+(?:-[ugCDhprtUT](?:\\S+|\\s+\\S+)|--[a-z][\\w-]*(?:=\\S+)?|-(?![ugCDhprtUT])[a-zA-Z]+))*?\\s+(?:/\\S*/)?(?:bash|sh|zsh|dash|ksh|fish)(?=\\s*(?:$|[;&|)]|-[il]\\b|--login\\b))|(?:^|[;&|(])\\s*(?:/\\S*/)?su(?=\\s|$|[;&|)])",
      "reason": "interactive root shell"
    }
  ],
  "gated_bash_deny": [
    {
      "pattern": "(?m)(?:^|[;&|(]|\\b(?:ba|z|k|da)?sh[ \\t]+-[a-zA-Z]*c[ \\t]+[\"'])[ \\t]*(?:(?:do|then|else|elif|if|while|until|!|\\{|command|[A-Za-z_]\\w*=(?:\"[^\"\\n]*\"|'[^'\\n]*'|[^\\s;&|()'\"]*)|(?:env|exec|nohup|setsid|time|timeout|nice|stdbuf|sudo|xargs)(?:[ \\t]+(?:-u[ \\t]+[^\\s;&|()]+|-(?!u[ \\t])[^\\s;&|()]+|\\d[^\\s;&|()]*|\\{\\}))*)[ \\t]+)*(?:[^\\s=;&|()'\"]*/)?(?:gemini|(?:claude|codex)(?![ \\t]+plugin(?=[\\s;&]|$)(?!(?:(?![ \\t]--[ \\t])[^\\n;&|()]){0,512}[ \\t](?:-p|--print)(?=[\\s;&|)]|$))))(?=[\\s;&]|$)(?![ \\t]*[-+*/]?=)(?![ \\t]+(?:--version|--help|mcp)(?=[\\s;&]|$)(?!(?:(?![ \\t]--[ \\t])[^\\n;&|()]){0,512}[ \\t](?:-p|--print)(?=[\\s;&|)]|$)))",
      "reason": "starting a coding-agent CLI (claude, codex, gemini) on an agent with gated skills: a nested run escapes Trinity's execution ledger and skill gates. Use your own tools, your Agent subagent tool where you have it, or chat_with_agent; do not script around this. If the match was only text in a quoted string or heredoc, put that text in a file with the Write tool"
    }
  ],
  "path_deny": [
    ".env",
    ".env.*",
    ".mcp.json",
    ".credentials.enc",
    "/home/developer/.ssh/*",
    "/home/developer/.aws/*",
    "/home/developer/.gcp/*",
    "/home/developer/.claude/settings.json",
    "/home/developer/.claude/settings.local.json",
    ".claude.json",
    "/home/developer/.claude/.credentials.json",
    "/home/developer/.gemini/settings.json",
    "/home/developer/.tmp/codex/*",
    "/home/developer/.trinity/read-only-config.json",
    "/opt/trinity/*",
    "/etc/claude-code/*",
    "/var/lib/trinity/*"
  ],
  "path_allow": [
    ".env.example"
  ],
  "credential_boundary": "(?:(?<![A-Za-z0-9-])|(?<=\\\\[nrt])|(?<=%[0-9A-Fa-f]{2})|(?P<lead>(?:\\x1b|\\\\(?:u001[bB]|x1[bB]|033|e))(?:\\[[0-?]*[ -/]*[@-~]|[ -/]*[0-~])))",
  "credential_patterns": [
    {"name": "sk", "source": "sk-[A-Za-z0-9][A-Za-z0-9_-]{19,}", "pattern": "sk-[A-Za-z0-9][A-Za-z0-9_-]{19,}"},
    {"name": "github", "source": "ghp_[a-zA-Z0-9]{36,}", "pattern": "ghp_[a-zA-Z0-9]{36,}"},
    {"name": "github", "source": "github_pat_[a-zA-Z0-9_]{22,}", "pattern": "github_pat_[a-zA-Z0-9_]{22,}"},
    {"name": "github", "source": "gho_[a-zA-Z0-9]{36,}", "pattern": "gho_[a-zA-Z0-9]{36,}"},
    {"name": "github", "source": "ghs_[a-zA-Z0-9]{36,}", "pattern": "ghs_[a-zA-Z0-9]{36,}"},
    {"name": "github", "source": "ghr_[a-zA-Z0-9]{36,}", "pattern": "ghr_[a-zA-Z0-9]{36,}"},
    {"name": "slack", "source": "xoxb-[a-zA-Z0-9\\-]+", "pattern": "xoxb-[a-zA-Z0-9\\-]{20,}", "tightening": "length floor 20"},
    {"name": "slack", "source": "xoxp-[a-zA-Z0-9\\-]+", "pattern": "xoxp-[a-zA-Z0-9\\-]{20,}", "tightening": "length floor 20"},
    {"name": "slack", "source": "xoxa-[a-zA-Z0-9\\-]+", "pattern": "xoxa-[a-zA-Z0-9\\-]{20,}", "tightening": "length floor 20"},
    {"name": "aws", "source": "AKIA[A-Z0-9]{16}", "pattern": "AKIA[A-Z0-9]{16}"},
    {"name": "trinity_mcp", "source": "trinity_mcp_(?:[A-Za-z0-9_-]{43}(?![A-Za-z0-9_-])|[a-zA-Z0-9]{16,})", "pattern": "trinity_mcp_(?:[A-Za-z0-9_-]{43}(?![A-Za-z0-9_-])|[a-zA-Z0-9]{16,})"},
    {"name": "ops", "source": "ops_eyJ[A-Za-z0-9_-]{40,}", "pattern": "ops_eyJ[A-Za-z0-9_-]{40,}"},
    {"name": "dop", "source": "dop_v1_[a-f0-9]{20,}", "pattern": "dop_v1_[a-f0-9]{20,}"},
    {"name": "google", "source": "AIza[0-9A-Za-z_-]{35}", "pattern": "AIza[0-9A-Za-z_-]{35}"}
  ],
  "max_turns_chat": 200,
  "max_turns_task": 200,
  "execution_timeout_sec": 1800,
  "extra_bash_deny": [],
  "extra_path_deny": [],
  "disallowed_tools": []
}
