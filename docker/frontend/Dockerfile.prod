# Production Dockerfile for Trinity Frontend
# Multi-stage build: npm build → nginx serving static assets

# Stage 1: Build
FROM node:26-alpine AS builder

WORKDIR /app

# Copy package files (lockfile is tracked — require it)
COPY package.json package-lock.json ./

# Install from the tracked lockfile (CSO M4: npm ci is lockfile-exact and fails
# on drift; the prior npm install floated semver ranges in the shipped bundle).
RUN npm ci

# Copy source code
COPY . .

# Build arguments (injected at build time)
# NOTE: every VITE_* var is statically inlined into the world-readable client
# bundle by Vite at `npm run build` — never pass a secret here. Defaults mirror
# the code source-of-truth in src/components/HelpChatWidget.vue (#1116/#1489).
ARG VITE_API_URL=http://localhost:8000
ARG VITE_BUG_REPORTING_ENABLED=true
ARG VITE_BUG_INTAKE_URL=https://intake.abilityai.dev/v1/report-bug

# Set environment variables for Vite build
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_BUG_REPORTING_ENABLED=${VITE_BUG_REPORTING_ENABLED}
ENV VITE_BUG_INTAKE_URL=${VITE_BUG_INTAKE_URL}

# Build the application
RUN npm run build

# Stage 2: Production nginx server (unprivileged variant — CSO hardening, issue #874)
FROM nginxinc/nginx-unprivileged:alpine

# nginxinc/nginx-unprivileged:alpine ends with `USER nginx` (UID 101).
# Toggle root for setup, then nginx for runtime — single pair so the
# subsequent RUN/COPY can write to /etc/nginx and /usr/share/nginx/html.
USER root

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# nginx config (trinity-enterprise#873). nginx.conf is a TEMPLATE with one
# substitution, the bridge gateway the PROXY-protocol listener trusts;
# render-nginx.sh fills it at start and writes the result to
# /etc/nginx/generated — the only nginx CONFIGURATION directory the
# unprivileged runtime user can write (the template, the shared server body and
# conf.d stay root-owned). conf.d/default.conf is a one-line include of it.
# nginx-server.conf is the server body both listeners share.
COPY --from=builder /app/nginx.conf /etc/nginx/trinity/nginx.conf.template
COPY --from=builder /app/nginx-server.conf /etc/nginx/nginx-server.conf
COPY --from=builder /app/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=builder /app/render-nginx.sh /usr/local/bin/render-nginx.sh
# The base image leaves /etc/nginx owned by the runtime user (for its envsubst
# templates, which this image does not use); take that back so the generated
# directory is the only configuration the running nginx could rewrite.
RUN chmod 0755 /usr/local/bin/render-nginx.sh \
    && printf 'include /etc/nginx/generated/default.conf;\n' > /etc/nginx/conf.d/default.conf \
    && chown -R root:root /etc/nginx \
    && chmod -R go-w /etc/nginx \
    && mkdir -p /etc/nginx/generated \
    && chown nginx:nginx /etc/nginx/generated

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Add curl for healthcheck (must be root)
RUN apk add --no-cache curl

USER nginx

# Unprivileged nginx binds 8080 (≥1024 needs no NET_BIND_SERVICE).
# Host-side port 80 mapping lives in docker-compose.prod.yml. 8082 is the
# PROXY-protocol listener (trinity-enterprise#873), published on loopback only.
EXPOSE 8080 8082

# The gateway of the default ingress network; compose passes the real one.
ENV TRINITY_PROXY_GATEWAY=172.30.0.1

# Render the one-variable template, then run nginx in the foreground.
CMD ["render-nginx.sh", "nginx", "-g", "daemon off;"]
